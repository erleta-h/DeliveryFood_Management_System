# Kopjoje si .env ne rrenjen e repo-s (prane FoodDelivery.sln)
# Ose ne src/FoodDelivery.Api/.env — API e lexon te dyja.
# MOS e commit-o .env — permban sekrete.
#
# Format: Seksioni__Fusha  (shembull Jwt__Secret = seksioni Jwt, fusha Secret)
# --- SQL Server (e detyrueshme) ---
# Përdorues, restorante, menu, porosi, pagesa, admin
# LocalDB: Server=(localdb)\mssqllocaldb;Database=FoodDeliveryDb_Dev;...
# Instancë SQL Server (ndërro emrin): Server=EMRI_I_LAPTOPIT\\MSSQLSERVER01;Database=FoodDeliveryDb_Dev;...
ConnectionStrings__DefaultConnection=Server=(localdb)\mssqllocaldb;Database=FoodDeliveryDb_Dev;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# --- MongoDB (chat dërgese — opsionale por e rekomanduar) ---
# Vetëm mesazhet klient ↔ korrier (NoSQL). SQL Server mbetet për pjesën tjetër.
Mongo__ConnectionString=mongodb://localhost:27017
Mongo__DatabaseName=FoodDelivery
# Mongo__Enabled=false   → API nis pa Mongo; chat nuk funksionon

# Docker: docker run -d -p 27017:27017 --name mongo mongo:7

# --- JWT (e detyrueshme në dev — ndryshoje për prod) ---
Jwt__Secret=DevOnly_DoNotUseInProduction_SuperSecretKey_32chars_Min__
Jwt__Issuer=FoodDelivery
Jwt__Audience=FoodDeliveryClients
# Jwt__AccessTokenMinutes=60
# Jwt__RefreshTokenDays=14

# --- Google Maps (opsionale) ---
# BrowserApiKey: kufizuar me HTTP referrer — shfaqet te klienti përmes /api/public/client-config
# ServerApiKey: vetëm server — Distance Matrix, Geocoding (mos e ekspozo në front)
GoogleMaps__BrowserApiKey=
GoogleMaps__ServerApiKey=
# Nominatim = falas (OSM). Google = kërkon ServerApiKey + Geocoding API të aktivizuar.
GoogleMaps__GeocodingProvider=Nominatim
# GoogleMaps__GeocodeRegion=Kosovo
# GoogleMaps__NominatimUserAgent=FoodDelivery/1.0 (contact@example.com)

# --- Stripe Test mode (opsionale — pagesa me kartë) ---
# https://dashboard.stripe.com/test/apikeys
# Stripe__PublishableKey=pk_test_xxxxxxxx
# Stripe__SecretKey=sk_test_xxxxxxxx
# Stripe__WebhookSecret=whsec_xxxxxxxx
