{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=FoodDeliveryDb_Dev;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "AutoMigrate": true
  },
  "Cors": {
    "Origins": []
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "FoodDelivery",
    "DeliveryChatCollection": "delivery_chat_messages"
  },
  "DriverActivation": {
    "WebAppBaseUrl": "http://localhost:5173",
    "TokenLifetimeHours": 48
  },
  "Jwt": {
    "Secret": "CHANGE_ME_DEV_ONLY_USE_LONG_SECRET_KEY_AT_LEAST_32_CHARS!",
    "Issuer": "FoodDelivery",
    "Audience": "FoodDeliveryClients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
