# Kopjoje si web/.env (opsionale)
# Vite lexon vetem variablat qe fillojne me VITE_
# Sekretet (JWT, Stripe, Google server) shkojn ne .env ne rrenje, jo ketu.
# URL e API-s që Vite proxy-ja në dev (/api dhe /hubs)
# Duhet të përputhet me launchSettings.json → http profile → port 5183
VITE_DEV_API_PROXY=http://localhost:5183

# HTTPS lokal — lëre të komentuar (parazgjedhja: HTTP)
# Aktivizo vetëm nëse e di çfarë bën; ndryshe ERR_SSL në Windows
# VITE_DEV_HTTPS=true
